{
  "name": "zinara-x-revolv-v6",
  "private": true,
  "version": "1.0.0",
  "description": "Zinara Shopify theme — dev tooling only (no build step; theme runs as vanilla Liquid/JS/CSS)",
  "scripts": {
    "format": "prettier --write \"sections/**/*.liquid\" \"snippets/**/*.liquid\" \"blocks/**/*.liquid\" \"layout/**/*.liquid\" \"assets/**/*.{css,js}\"",
    "lint:theme": "shopify theme check",
    "lint:css": "stylelint \"assets/**/*.css\"",
    "dev": "shopify theme dev"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.7.4",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
