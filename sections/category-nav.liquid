{{ 'category-nav.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign primary_blocks = section.blocks | where: 'settings.align_end', false
  assign secondary_blocks = section.blocks | where: 'settings.align_end', true
-%}

{%- if section.blocks.size > 0 -%}
  <nav class="category-nav" aria-label="Category navigation">
    <div class="category-nav_wrapper">
      <ul class="category-nav_wrapper_primary">
        {%- for block in primary_blocks -%}
          <li
            class="category-nav_wrapper_item{% if block.settings.url == request.path %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="category-nav_wrapper_item_content">
              <a href="{{ block.settings.url | default: '#' }}" class="category-nav_wrapper_item_content_link">
                {{ block.settings.label }}
              </a>
              {%- if block.settings.show_new_badge -%}
                <span class="category-nav_wrapper_item_content_badge">{{ 'labels.new' | t }}</span>
              {%- endif -%}
            </span>
            <span class="category-nav_wrapper_item_underline"></span>
          </li>
        {%- endfor -%}
      </ul>

      {%- if secondary_blocks.size > 0 -%}
        <ul class="category-nav_wrapper_secondary">
          {%- for block in secondary_blocks -%}
            <li
              class="category-nav_wrapper_item{% if block.settings.url == request.path %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="category-nav_wrapper_item_content">
                <a href="{{ block.settings.url | default: '#' }}" class="category-nav_wrapper_item_content_link">
                  {{ block.settings.label }}
                </a>
                {%- if block.settings.show_new_badge -%}
                  <span class="category-nav_wrapper_item_content_badge">{{ 'labels.new' | t }}</span>
                {%- endif -%}
              </span>
              <span class="category-nav_wrapper_item_underline"></span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Category nav",
  "tag": "section",
  "class": "shopify-section--category-nav",
  "settings": [],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "show_new_badge",
          "label": "Show \"NEW\" badge",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "align_end",
          "label": "Align to end of bar",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category nav",
      "blocks": [
        { "type": "link", "settings": { "label": "Shop all" } },
        { "type": "link", "settings": { "label": "New arrivals" } },
        { "type": "link", "settings": { "label": "Rakhi collection", "show_new_badge": true } },
        { "type": "link", "settings": { "label": "Rings" } },
        { "type": "link", "settings": { "label": "Earrings" } },
        { "type": "link", "settings": { "label": "Pendants/Necklaces" } },
        { "type": "link", "settings": { "label": "Bracelets" } },
        { "type": "link", "settings": { "label": "About us", "align_end": true } },
        { "type": "link", "settings": { "label": "Contact us", "align_end": true } }
      ]
    }
  ]
}
{% endschema %}
