{{ 'journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog = blogs[section.settings.blog]
-%}

{%- if blog and blog.articles.size > 0 -%}
  <section class="journal">
    <div class="journal_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="journal_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="journal_wrapper_grid" data-animate>
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          <a href="{{ article.url }}" class="journal_wrapper_grid_card{% if forloop.first %} is-featured{% endif %}">
            {%- if forloop.first -%}
              <span class="journal_wrapper_grid_card_tag">FEATURED</span>
            {%- endif -%}
            <span class="journal_wrapper_grid_card_image">
              {%- if article.image -%}
                {{ article.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: article.title }}
              {%- endif -%}
            </span>
            <span class="journal_wrapper_grid_card_date">{{ article.published_at | date: '%-d %B, %Y' }}</span>
            <span class="journal_wrapper_grid_card_title">{{ article.title }}</span>
            <span class="journal_wrapper_grid_card_excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</span>
            <span class="journal_wrapper_grid_card_readmore">
              {{ 'icon-caret-left.svg' | inline_asset_content }}
              Read more
              {{ 'icon-caret-right.svg' | inline_asset_content }}
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "class": "shopify-section--journal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The jewellery journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
