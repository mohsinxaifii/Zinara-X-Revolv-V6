{{ 'header.css' | asset_url | stylesheet_tag }}

<header-component class="header full-width" data-drawer-open="false">
  <div class="header_wrapper">
    <div class="header_wrapper_brand">
      <button
        type="button"
        class="header_wrapper_brand_menu-toggle"
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-expanded="false"
        aria-controls="header-drawer-{{ section.id }}"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>

      <a href="{{ routes.root_url }}" class="header_wrapper_brand_logo">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag: loading: 'eager', width: settings.logo_width, alt: shop.name
          }}
        {%- else -%}
          {{ 'logo.svg' | inline_asset_content }}
        {%- endif -%}
      </a>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="header_wrapper_search">
      <button type="submit" class="header_wrapper_search_icon" aria-label="{{ 'accessibility.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
      <input
        type="search"
        name="q"
        class="header_wrapper_search_input"
        placeholder="{{ 'search.placeholder_short' | t }}"
        autocomplete="off"
        value="{{ search.terms | escape }}"
      >
      <input type="hidden" name="type" value="product">
    </form>

    <div class="header_wrapper_actions">
      <a
        href="{{ routes.account_url }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        {{ 'icon-user.svg' | inline_asset_content }}
      </a>

      <a
        href="{{ section.settings.wishlist_url | default: '#' }}"
        class="header_wrapper_actions_link"
        aria-label="{{ 'accessibility.wishlist' | t }}"
      >
        {{ 'icon-heart.svg' | inline_asset_content }}
      </a>

      <a href="{{ routes.cart_url }}" class="header_wrapper_actions_link" aria-label="{{ 'accessibility.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {%- if cart.item_count > 0 -%}
          <span class="header_wrapper_actions_cart_badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="header_drawer_overlay" inert></div>
  <div
    class="header_drawer"
    id="header-drawer-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    inert
    aria-label="{{ 'accessibility.menu' | t }}"
  >
    <button type="button" class="header_drawer_close" aria-label="{{ 'accessibility.close_menu' | t }}">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <nav class="header_drawer_nav">
      <ul class="header_drawer_nav_list">
        {%- for link in section.settings.menu.links -%}
          <li class="header_drawer_nav_list_item">
            {%- if link.links != blank -%}
              <button
                type="button"
                class="header_drawer_nav_list_item_toggle"
                aria-expanded="false"
              >
                <span>{{ link.title }}</span>
                {{ 'icon-caret-down.svg' | inline_asset_content }}
              </button>
              <ul class="header_drawer_nav_sublist" hidden>
                {%- for childlink in link.links -%}
                  <li>
                    <a href="{{ childlink.url }}" class="header_drawer_nav_sublist_link">{{ childlink.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="header_drawer_nav_list_item_link{% if link.url == request.path %} is-active{% endif %}"
              >
                {{ link.title }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header_drawer_footer">
      <a href="{{ routes.account_url }}" class="header_drawer_footer_account">
        {{ 'icon-user.svg' | inline_asset_content }}
        <span>
          {%- if customer -%}
            {{ 'accessibility.account' | t }}
          {%- else -%}
            {{ 'accessibility.login' | t }}
          {%- endif -%}
        </span>
      </a>
      <div class="header_drawer_footer_social">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
            {{- 'icon-instagram.svg' | inline_asset_content -}}
          </a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
            {{- 'icon-facebook.svg' | inline_asset_content -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header-component>

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ]
}
{% endschema %}
