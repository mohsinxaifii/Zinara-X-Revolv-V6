{{ 'logo-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .logo-marquee {
    background-color: {{ section.settings.background_color }};
    --logo-marquee-speed: {{ section.settings.speed }}s;
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section class="logo-marquee full-width">
    <div class="logo-marquee_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="logo-marquee_wrapper_heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="logo-marquee_wrapper_track">
        <div class="logo-marquee_wrapper_track_set">
          {%- for block in section.blocks -%}
            <span class="logo-marquee_wrapper_track_set_logo">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
        <div class="logo-marquee_wrapper_track_set" aria-hidden="true">
          {%- for block in section.blocks -%}
            <span class="logo-marquee_wrapper_track_set_logo">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Logo marquee",
  "tag": "section",
  "class": "shopify-section--logo-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured in"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FEF4E2"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Logo" }]
    }
  ],
  "presets": [
    {
      "name": "Logo marquee",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
