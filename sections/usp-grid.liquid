{{ 'usp-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .usp-grid {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section class="usp-grid full-width">
    <div class="usp-grid_wrapper" data-animate>
      {%- for block in section.blocks -%}
        <div class="usp-grid_wrapper_cell" {{ block.shopify_attributes }}>
          {%- if block.settings.icon -%}
            <span
              class="usp-grid_wrapper_cell_icon"
              style="--usp-grid-icon: url({{ block.settings.icon | image_url: width: 64 }});"
              role="presentation"
            ></span>
          {%- endif -%}
          <span class="usp-grid_wrapper_cell_text">{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "USP grid",
  "tag": "section",
  "class": "shopify-section--usp-grid",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "info": "32px on the home page, 48px on the contact page.",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Cell",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text", "default": "Benefit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP grid",
      "blocks": [
        { "type": "cell", "settings": { "text": "Lifetime buyback & exchange" } },
        { "type": "cell", "settings": { "text": "Handcrafted" } },
        { "type": "cell", "settings": { "text": "Lifetime buyback & exchange" } },
        { "type": "cell", "settings": { "text": "Insured & free shipping" } }
      ]
    }
  ]
}
{% endschema %}
