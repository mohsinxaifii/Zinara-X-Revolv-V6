{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'know-your-jewellery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign vermeil_blocks = section.blocks | where: 'type', 'vermeil_fact'
  assign flip_blocks = section.blocks | where: 'type', 'myth_fact'
-%}

<section class="know-your-jewellery">
  <div class="know-your-jewellery_wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="know-your-jewellery_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="know-your-jewellery_wrapper_grid">
      <div class="know-your-jewellery_wrapper_grid_vermeil" data-animate>
        <h3 class="know-your-jewellery_wrapper_grid_vermeil_title">{{ section.settings.vermeil_title }}</h3>

        <div class="know-your-jewellery_wrapper_grid_vermeil_diagram">
          {%- if section.settings.vermeil_image -%}
            <span class="know-your-jewellery_wrapper_grid_vermeil_diagram_image">
              {{
                section.settings.vermeil_image
                | image_url: width: 480
                | image_tag: loading: 'lazy', alt: section.settings.vermeil_title
              }}
            </span>
          {%- endif -%}

          <svg
            class="know-your-jewellery_wrapper_grid_vermeil_diagram_lines"
            viewBox="0 0 536.5 238"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <line x1="178" y1="36.2" x2="225.8" y2="99.8" />
            <line x1="269.8" y1="61" x2="269.8" y2="100.1" />
            <line x1="228.8" y1="187.8" x2="262.9" y2="211" />
          </svg>

          {%- for block in vermeil_blocks limit: 3 -%}
            <div
              class="know-your-jewellery_wrapper_grid_vermeil_diagram_callout know-your-jewellery_wrapper_grid_vermeil_diagram_callout--{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon -%}
                <span class="know-your-jewellery_wrapper_grid_vermeil_diagram_callout_icon">
                  {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
                </span>
              {%- endif -%}
              <span class="know-your-jewellery_wrapper_grid_vermeil_diagram_callout_text">{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="know-your-jewellery_wrapper_grid_diamonds" data-animate>
        <h3 class="know-your-jewellery_wrapper_grid_diamonds_title">{{ section.settings.diamonds_title }}</h3>

        <card-stack class="know-your-jewellery_wrapper_grid_diamonds_carousel">
          <div class="know-your-jewellery_wrapper_grid_diamonds_stack_wrap">
          <div class="know-your-jewellery_wrapper_grid_diamonds_stack">
            <div class="know-your-jewellery_wrapper_grid_diamonds_stack_item is-active" data-stack-item>
              <div class="know-your-jewellery_wrapper_grid_diamonds_compare">
                <span class="know-your-jewellery_wrapper_grid_diamonds_compare_tag">FACT</span>
                <div class="know-your-jewellery_wrapper_grid_diamonds_compare_row">
                  <div class="know-your-jewellery_wrapper_grid_diamonds_compare_row_stat">
                    {%- if section.settings.mined_image -%}
                      {{
                        section.settings.mined_image
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', alt: 'Mined diamond'
                      }}
                    {%- endif -%}
                    <strong>{{ section.settings.mined_value }}</strong>
                    <span>{{ section.settings.mined_label }}</span>
                  </div>
                  <div class="know-your-jewellery_wrapper_grid_diamonds_compare_row_stat">
                    <strong class="is-accent">
                      {{ section.settings.co2_reduction }}
                      {{ 'icon-trend-down.svg' | inline_asset_content }}
                    </strong>
                    <span>{{ section.settings.co2_label }}</span>
                  </div>
                  <div class="know-your-jewellery_wrapper_grid_diamonds_compare_row_stat">
                    {%- if section.settings.mined_image -%}
                      {{
                        section.settings.mined_image
                        | image_url: width: 40
                        | image_tag: loading: 'lazy', alt: 'Lab grown diamond'
                      }}
                    {%- endif -%}
                    <strong>{{ section.settings.lab_grown_value }}</strong>
                    <span>{{ section.settings.lab_grown_label }}</span>
                  </div>
                </div>
              </div>
            </div>

            {%- for block in flip_blocks -%}
              <flip-card
                class="know-your-jewellery_wrapper_grid_diamonds_stack_item know-your-jewellery_wrapper_grid_diamonds_flip_card"
                data-stack-item
                role="button"
                tabindex="0"
                {{ block.shopify_attributes }}
              >
                <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_face know-your-jewellery_wrapper_grid_diamonds_flip_card_face--myth">
                  <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_label">MYTH</span>
                  <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_quote"
                    >&ldquo;{{ block.settings.myth }}&rdquo;</span
                  >
                  <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_hint">Tap to reveal fact</span>
                </span>
                <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_face know-your-jewellery_wrapper_grid_diamonds_flip_card_face--fact">
                  <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_label">FACT</span>
                  <span class="know-your-jewellery_wrapper_grid_diamonds_flip_card_quote">
                    {{- block.settings.fact -}}
                  </span>
                </span>
              </flip-card>
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="know-your-jewellery_wrapper_grid_diamonds_stack_arrow know-your-jewellery_wrapper_grid_diamonds_stack_arrow--prev"
            data-prev
            aria-label="{{ 'accessibility.previous_page' | t }}"
          >
            {{ 'icon-caret-left.svg' | inline_asset_content }}
          </button>
          <button
            type="button"
            class="know-your-jewellery_wrapper_grid_diamonds_stack_arrow know-your-jewellery_wrapper_grid_diamonds_stack_arrow--next"
            data-next
            aria-label="{{ 'accessibility.next_page' | t }}"
          >
            {{ 'icon-caret-right.svg' | inline_asset_content }}
          </button>
          </div>

          <div class="know-your-jewellery_wrapper_grid_diamonds_dots" data-dots></div>
        </card-stack>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'know-your-jewellery.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Know your jewellery",
  "tag": "section",
  "class": "shopify-section--know-your-jewellery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know Your Jewellery"
    },
    {
      "type": "text",
      "id": "vermeil_title",
      "label": "Left card title",
      "default": "Gold Vermeil"
    },
    {
      "type": "image_picker",
      "id": "vermeil_image",
      "label": "Left card image"
    },
    {
      "type": "text",
      "id": "diamonds_title",
      "label": "Right card title",
      "default": "Lab Grown Diamonds"
    },
    {
      "type": "header",
      "content": "Diamond comparison stat"
    },
    {
      "type": "image_picker",
      "id": "mined_image",
      "label": "Diamond icon"
    },
    {
      "type": "text",
      "id": "mined_value",
      "label": "Mined diamond value",
      "default": "160kg / carat"
    },
    {
      "type": "text",
      "id": "mined_label",
      "label": "Mined diamond label",
      "default": "Mined diamond"
    },
    {
      "type": "text",
      "id": "co2_reduction",
      "label": "CO2 reduction stat",
      "default": "96%"
    },
    {
      "type": "text",
      "id": "co2_label",
      "label": "CO2 stat label",
      "default": "CO2 emission"
    },
    {
      "type": "text",
      "id": "lab_grown_value",
      "label": "Lab grown value",
      "default": "6kg / carat"
    },
    {
      "type": "text",
      "id": "lab_grown_label",
      "label": "Lab grown label",
      "default": "Lab grown diamond"
    }
  ],
  "blocks": [
    {
      "type": "vermeil_fact",
      "name": "Vermeil fact",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text", "default": "Fact" }
      ]
    },
    {
      "type": "myth_fact",
      "name": "Myth / fact card",
      "settings": [
        { "type": "text", "id": "myth", "label": "Myth", "default": "Lab grown diamonds are fake diamonds." },
        { "type": "textarea", "id": "fact", "label": "Fact (revealed on tap)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Know your jewellery",
      "blocks": [
        { "type": "vermeil_fact", "settings": { "text": "Looks and feels like solid gold" } },
        { "type": "vermeil_fact", "settings": { "text": "Sweat and waterproof" } },
        { "type": "vermeil_fact", "settings": { "text": "5x thicker gold plating" } },
        { "type": "myth_fact" }
      ]
    }
  ]
}
{% endschema %}
