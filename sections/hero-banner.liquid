{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <hero-banner-slideshow
    class="hero-banner"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="hero-banner_wrapper">
      <div class="hero-banner_wrapper_track">
        {%- for block in section.blocks -%}
          <div
            class="hero-banner_wrapper_track_slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              if forloop.first
                assign slide_loading = 'eager'
                assign slide_fetchpriority = 'high'
              else
                assign slide_loading = 'lazy'
                assign slide_fetchpriority = 'auto'
              endif

              assign slide_alt = block.settings.image.alt | default: block.settings.heading
              assign slide_alt = slide_alt | default: shop.name
            -%}
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 2000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_fetchpriority,
                  widths: '750,1100,1500,2000',
                  sizes: '100vw',
                  class: 'hero-banner_wrapper_track_slide_image',
                  alt: slide_alt
              }}
            {%- endif -%}

            {%- if block.settings.heading != blank
              or block.settings.subheading != blank
              or block.settings.button_label != blank
            -%}
              <div class="hero-banner_wrapper_track_slide_content">
                {%- if block.settings.heading != blank -%}
                  <h2 class="hero-banner_wrapper_track_slide_content_heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="hero-banner_wrapper_track_slide_content_subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a
                    href="{{ block.settings.button_url | default: '#' }}"
                    class="hero-banner_wrapper_track_slide_content_button"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button type="button" class="hero-banner_wrapper_prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
          {{ 'icon-caret-left.svg' | inline_asset_content }}
        </button>
        <button type="button" class="hero-banner_wrapper_next" aria-label="{{ 'accessibility.next_slide' | t }}">
          {{ 'icon-caret-right.svg' | inline_asset_content }}
        </button>

        <div class="hero-banner_wrapper_dots" role="tablist" aria-label="{{ 'accessibility.slides' | t }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hero-banner_wrapper_dots_dot{% if forloop.first %} is-active{% endif %}"
              data-dot-index="{{ forloop.index0 }}"
              role="tab"
              aria-label="{{ 'accessibility.go_to_slide' | t: number: forloop.index }}"
              aria-selected="{{ forloop.first }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </hero-banner-slideshow>

  <script src="{{ 'hero-banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "shopify-section--hero-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/zinara-hero-slide-1.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
