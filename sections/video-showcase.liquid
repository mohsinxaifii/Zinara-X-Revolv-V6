{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'video-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <scroll-carousel class="video-showcase">
    <div class="video-showcase_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="video-showcase_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="video-showcase_wrapper_track" data-track>
        {%- for block in section.blocks -%}
          <video-card class="video-showcase_wrapper_track_item" {{ block.shopify_attributes }}>
            {%- if block.settings.cover_image -%}
              <span class="video-showcase_wrapper_track_item_poster">
                {{
                  block.settings.cover_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '282px', alt: ''
                }}
              </span>
            {%- endif -%}

            {%- if block.settings.video != blank -%}
              <button
                type="button"
                class="video-showcase_wrapper_track_item_play"
                data-play-video
                aria-label="Play video"
              >
                {{ 'icon-play.svg' | inline_asset_content }}
              </button>
              <span class="video-showcase_wrapper_track_item_video" hidden>
                {{ block.settings.video | video_tag: controls: true, muted: false, image_size: '600x' }}
              </span>
            {%- elsif block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="video-showcase_wrapper_track_item_play" aria-label="View">
                {{ 'icon-play.svg' | inline_asset_content }}
              </a>
            {%- endif -%}
          </video-card>
        {%- endfor -%}
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>

    <button
      type="button"
      class="scroll-carousel_arrow video-showcase_arrow"
      data-next
      aria-label="{{ 'accessibility.next_page' | t }}"
    >
      {{ 'icon-caret-right.svg' | inline_asset_content }}
    </button>
  </scroll-carousel>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'video-showcase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Video showcase",
  "tag": "section",
  "class": "shopify-section--video-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated trends for you"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
        { "type": "video", "id": "video", "label": "Video (optional)" },
        { "type": "url", "id": "link", "label": "Link (used if no video)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video showcase",
      "blocks": [{ "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }]
    }
  ]
}
{% endschema %}
