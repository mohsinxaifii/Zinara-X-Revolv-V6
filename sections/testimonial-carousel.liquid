{{ 'scroll-carousel.css' | asset_url | stylesheet_tag }}
{{ 'testimonial-carousel.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <scroll-carousel class="testimonial-carousel full-width">
    <div class="testimonial-carousel_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonial-carousel_wrapper_heading" data-animate>{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="testimonial-carousel_wrapper_track" data-track>
        {%- for block in section.blocks -%}
          <div class="testimonial-carousel_wrapper_track_card" {{ block.shopify_attributes }}>
            <span class="testimonial-carousel_wrapper_track_card_image">
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 260
                  | image_tag: loading: 'lazy', alt: block.settings.name
                }}
              {%- endif -%}
            </span>
            <div class="testimonial-carousel_wrapper_track_card_content">
              <span
                class="testimonial-carousel_wrapper_track_card_content_stars"
                aria-label="{{ block.settings.rating }} out of 5 stars"
              >
                {%- for i in (1..5) -%}
                  <span class="testimonial-carousel_wrapper_track_card_content_stars_star{% if i > block.settings.rating %} is-empty{% endif %}">
                    {{- 'icon-star.svg' | inline_asset_content -}}
                  </span>
                {%- endfor -%}
              </span>
              <p class="testimonial-carousel_wrapper_track_card_content_name">{{ block.settings.name }}</p>
              <p class="testimonial-carousel_wrapper_track_card_content_quote">
                {{ block.settings.quote | truncate: 140 }}
                <button
                  type="button"
                  class="testimonial-carousel_wrapper_track_card_content_quote_readmore"
                  data-open-dialog="review-dialog-{{ section.id }}-{{ forloop.index }}"
                >
                  Read more
                </button>
              </p>
              {%- if block.settings.product != blank -%}
                <a
                  href="{{ block.settings.product.url }}"
                  class="testimonial-carousel_wrapper_track_card_content_product"
                >
                  {{- block.settings.product.title -}}
                </a>
              {%- endif -%}
            </div>
          </div>

          <dialog id="review-dialog-{{ section.id }}-{{ forloop.index }}" class="review-dialog">
            <button type="button" class="review-dialog_close" data-close-dialog aria-label="{{ 'accessibility.close_menu' | t }}">
              {{ 'icon-close.svg' | inline_asset_content }}
            </button>
            <p class="review-dialog_title">Review</p>
            <span class="review-dialog_stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="review-dialog_stars_star{% if i > block.settings.rating %} is-empty{% endif %}">
                  {{- 'icon-star.svg' | inline_asset_content -}}
                </span>
              {%- endfor -%}
            </span>
            <p class="review-dialog_name">{{ block.settings.name }}</p>
            <p class="review-dialog_quote">{{ block.settings.quote }}</p>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="review-dialog_product">{{ block.settings.product.title }}</a>
            {%- endif -%}
          </dialog>
        {%- endfor -%}
      </div>

      <div class="scroll-carousel_dots" data-dots></div>
    </div>

    <button
      type="button"
      class="scroll-carousel_arrow testimonial-carousel_arrow"
      data-next
      aria-label="{{ 'accessibility.next_page' | t }}"
    >
      {{ 'icon-caret-right.svg' | inline_asset_content }}
    </button>
  </scroll-carousel>

  <script src="{{ 'scroll-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section--testimonial-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "They tried it. They loved it!"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "url", "id": "quote_link", "label": "\"Read more\" link (optional)" },
        { "type": "product", "id": "product", "label": "Product mentioned" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
